<style is:global>
    :root {
        --font-serif-zh: "Noto Serif SC", "Noto Serif", ui-serif,
            "Source Han Serif SC", "Songti SC", "STSong", "Hiragino Mincho ProN",
            Georgia, "Times New Roman", Times, serif;
        --font-serif-en: "Noto Serif SC", "Noto Serif", ui-serif,
            "Source Han Serif SC", "Songti SC", "STSong",
            "Hiragino Mincho ProN", Georgia, "Times New Roman", Times, serif;
        --font-sans-zh: "Noto Sans SC", "Noto Sans", ui-sans-serif, "PingFang SC",
            "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans CJK SC",
            "Helvetica Neue", "Segoe UI", Arial, sans-serif;
        --font-sans-en: "Noto Sans", ui-sans-serif, -apple-system,
            BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", Arial,
            "Noto Sans SC", "PingFang SC", "Hiragino Sans GB",
            "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
        --font-serif: var(--font-serif-zh);
        --font-sans: var(--font-sans-zh);

        /* Semantic typography roles
         * - content: prose and narrative navigation
         * - control: commands, filters, pagination and form actions
         * - status: editorial metadata such as language/fallback badges
         */
        --font-content: var(--font-serif);
        --font-control: var(--font-sans);
        --font-status: var(--font-serif);
    }

    html[lang="en"] {
        --font-serif: var(--font-serif-en);
        --font-sans: var(--font-sans-en);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    html[lang="zh"] {
        --font-serif: var(--font-serif-zh);
        --font-sans: var(--font-sans-zh);
    }

    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    /* 全站正文默认使用衬线字体；动作控件由下方规则切换为无衬线字体 */
    html,
    body {
        font-family: var(--font-serif);
    }

    button,
    input[type="button"],
    input[type="submit"],
    input[type="reset"] {
        font-family: var(--font-control);
    }

    .language-badge {
        font-family: var(--font-status);
    }
    :root {
        --purple: #a259ec;
        --bg: #fff;
        --text: #222;
        --grey: #888;
        --icon-size: 1.4rem;

        /* Ender ambient tokens (light defaults: end-stone washed palette) */
        --end-sky-deep: #f1edd8; /* warm pale (end stone) */
        --end-sky-dark: #fbf9ef; /* near-white warm */
        --end-ambient-purple: rgba(
            162,
            89,
            236,
            0.06
        ); /* faint lavender wash */
        --end-ambient-pale: rgba(224, 214, 170, 0.08); /* warm dust glow */
        --end-pale: #d8d1b0; /* washed pale yellow */
        --end-noise-opacity: 0.08; /* lighter grain in day */
    }

    html,
    body {
        min-height: 100%;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
        background: var(--bg);
        color: var(--text);
        font-family: var(--font-serif);
        font-weight: 300;
        transition:
            background 0.3s,
            color 0.3s;
    }

    /* Safari scrollbar track: match page background to prevent gradient bleed */
    html.is-safari::-webkit-scrollbar {
        width: 8px;
    }
    html.is-safari::-webkit-scrollbar-track {
        background: var(--bg);
    }
    html.is-safari::-webkit-scrollbar-thumb {
        background: rgba(162, 89, 236, 0.3);
        border-radius: 4px;
    }

    body {
        display: block;
        height: auto;
        min-height: 100vh;
        color: var(--text);
        position: relative;
        visibility: visible;
        justify-content: initial;
        align-items: initial;
    }

    @media (max-width: 600px) {
        body:not(.has-header) .theme-toggle {
            top: 10px;
            right: 10px;
            font-size: 1.3rem;
        }

        body:not(.has-header) .lang-toggle {
            top: 10px;
            right: 10px;
            font-size: 1.3rem;
        }
    }

    html.dark {
        --bg: #070615;
        --text: #f7f7fc;
        --grey: #a6a6c1;

        --end-sky-deep: #0d0817;
        --end-sky-dark: #070512;
        --end-ambient-purple: rgba(162, 89, 236, 0.16);
        --end-ambient-pale: rgba(242, 231, 185, 0.08);
        --end-pale: #f2e7b9;
        --end-noise-opacity: 0.16; /* slightly stronger grain at night */
    }

    html.dark body {
        background: var(--bg);
        color: var(--text);
    }

    body:not(.has-header) .theme-toggle {
        position: absolute;
        top: 24px;
        right: 36px;
        cursor: pointer;
        background: transparent;
        border: none;
        outline: none;
        font-size: 1.6rem;
        color: var(--theme-toggle-color, #8a8a8a);
        transition:
            color 0.25s,
            background 0.3s;
        z-index: 10;
        padding: 4px 7px;
        border-radius: 50%;
        box-shadow: 0 1px 8px 0 rgba(162, 89, 236, 0.05);
        user-select: none;
    }

    .theme-toggle:hover {
        background: rgba(162, 89, 236, 0.1);
    }

    html.dark body:not(.has-header) .theme-toggle {
        color: #b5aed6;
    }

    body:not(.has-header) .lang-toggle {
        position: absolute;
        top: 24px;
        right: 100px;
        cursor: pointer;
        background: transparent;
        border: none;
        outline: none;
        font-size: 1.6rem;
        color: var(--lang-toggle-color, #8a8a8a);
        transition:
            color 0.25s,
            background 0.3s;
        z-index: 10;
        padding: 4px 7px;
        border-radius: 50%;
        box-shadow: 0 1px 8px 0 rgba(162, 89, 236, 0.05);
        user-select: none;
    }
    html.dark body:not(.has-header) .lang-toggle {
        color: #b5aed6;
    }
    .lang-icon {
        display: inline-block;
        transition: transform 0.3s;
    }

    .lang-toggle:hover {
        background: rgba(162, 89, 236, 0.1);
    }
    html.no-transition,
    html.no-transition * {
        transition: none !important;
    }

    /* ── Inline HTML component design tokens (light) ── */
    :root {
        --font-mono: 'SF Mono', 'Fira Code', 'Cascadia Code', ui-monospace, monospace;
        --border-radius-lg: 10px;
        --border-radius-md: 6px;

        --color-background-primary:   #ffffff;
        --color-background-secondary: #f4f4f6;
        --color-background-tertiary:  #eaeaee;

        --color-text-primary:   #1a1a2e;
        --color-text-secondary: #5c5c78;
        --color-text-tertiary:  #9a9ab0;

        --color-border-primary:   #c0c0d0;
        --color-border-secondary: #d8d8e8;
        --color-border-tertiary:  #ebebf2;

        --color-text-info:         #1d5fa8;
        --color-background-info:   #ddeeff;
        --color-border-info:       #90b8e8;

        --color-text-warning:         #92510a;
        --color-background-warning:   #fef3c7;
        --color-border-warning:       #f5c06a;

        --color-text-success:         #1a5c34;
        --color-background-success:   #d1fae5;
        --color-border-success:       #6ee7b7;

        --color-text-danger:         #b91c1c;
        --color-background-danger:   #fee2e2;
        --color-border-danger:       #fca5a5;
    }

    /* ── dark mode overrides ── */
    html.dark {
        --color-background-primary:   #070615;
        --color-background-secondary: #0f0e20;
        --color-background-tertiary:  #1a1930;

        --color-text-primary:   #f0effc;
        --color-text-secondary: #a6a6c1;
        --color-text-tertiary:  #66668a;

        --color-border-primary:   #38375a;
        --color-border-secondary: #28274a;
        --color-border-tertiary:  #1e1d38;

        --color-text-info:         #7ab8f5;
        --color-background-info:   #162840;
        --color-border-info:       #3a6090;

        --color-text-warning:         #fbbf24;
        --color-background-warning:   #2d1f00;
        --color-border-warning:       #8a5a00;

        --color-text-success:         #4ade80;
        --color-background-success:   #052e16;
        --color-border-success:       #166534;

        --color-text-danger:         #f87171;
        --color-background-danger:   #3b0a0a;
        --color-border-danger:       #991b1b;
    }
    body.theme-loaded {
        visibility: visible;
    }

    /* Avoid clipping descenders in large EN hero titles */
    html[lang="en"] .about-hero-slogan,
    html[lang="en"] .blog-hero-slogan,
    html[lang="en"] .categories-hero-slogan,
    html[lang="en"] .memos-hero-slogan,
    html[lang="en"] .friends-hero-title,
    html[lang="en"] .hero-slogan,
    html[lang="en"] .manifesto,
    html[lang="en"] .title-zh {
        line-height: 1.28;
        padding-bottom: 0.08em;
    }

    .notes-intro {
        font-family: var(--font-serif);
        width: min(38rem, calc(100vw - 40px));
        margin: 0.95rem auto 0;
        padding: 0.25rem 0;
        text-align: center;
        font-size: 1rem;
        color: var(--grey);
        line-height: 1.9;
        letter-spacing: 0.01em;
        opacity: 0.9;
    }

    @media (max-width: 768px) {
        .notes-intro {
            width: min(34rem, calc(100vw - 40px));
            margin-top: 0.8rem;
            font-size: 0.96rem;
            line-height: 1.8;
        }
    }

    /* ── Apple Music embed ──────────────────────────────────────────
       Shared by <AppleMusicEmbed> and the ::apple-music markdown
       directive. Defined globally so Markdown-rendered iframes (which
       sit outside any scoped component) pick it up too. */
    .apple-music-embed {
        width: 100%;
        max-width: 660px;
        margin: 1.5rem auto;
        border-radius: 14px;
        overflow: hidden;
        /* Reserve height so the lazy iframe doesn't shift layout. */
        min-height: var(--am-height, 450px);
        background: color-mix(in srgb, var(--grey, #888) 8%, transparent);
    }

    .apple-music-embed iframe {
        width: 100%;
        height: var(--am-height, 450px);
        display: block;
        border: 0;
        border-radius: 14px;
        background: transparent;
    }

    .apple-music-embed-error {
        margin: 1rem 0;
        color: var(--grey);
        font-size: 0.92rem;
    }
</style>
