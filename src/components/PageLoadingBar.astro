---
// 顶部页面加载进度条组件
---

<div id="page-loading-bar" class="page-loading-bar"></div>

<style>
  .page-loading-bar {
    position: fixed;
    top: 0;
    left: 0;
    width: 0%;
    height: 3px;
    background: linear-gradient(90deg, var(--purple), #c084fc);
    z-index: 9999;
    opacity: 0;
    transition: opacity 0.2s ease;
    box-shadow: 0 0 10px var(--purple), 0 0 5px var(--purple);
  }

  .page-loading-bar.loading {
    opacity: 1;
    transition: width 0.3s ease-out, opacity 0.2s ease;
  }

  .page-loading-bar.complete {
    width: 100% !important;
    transition: width 0.2s ease-in, opacity 0.3s ease 0.3s;
    opacity: 0;
  }

  /* 深色模式优化 */
  html.dark .page-loading-bar {
    background: linear-gradient(90deg, #a259ec, #c084fc, #e0b3ff);
  }

  /* 白天模式优化 */
  html:not(.dark) .page-loading-bar {
    background: linear-gradient(90deg, #8b3ad1, #a259ec, #b57ce8);
    box-shadow: 0 0 10px rgba(162, 89, 236, 0.5), 0 0 5px rgba(162, 89, 236, 0.3);
  }
</style>

<script>
  // ── Loading Bar ──────────────────────────────────────────────
  // IMPORTANT: Event listeners are registered ONCE. The old code
  // re-registered them on every astro:page-load, causing N copies
  // of startLoading (each with its own setInterval) to pile up.
  // After long idle periods the accumulated timers would choke
  // the main thread, making navigation feel unresponsive.

  const bar = document.getElementById('page-loading-bar');

  let progress = 0;
  let interval: number | null = null;
  let loadingTimeout: number | null = null;

  function cleanTimers() {
    if (loadingTimeout) { clearTimeout(loadingTimeout); loadingTimeout = null; }
    if (interval)       { clearInterval(interval);      interval = null;       }
  }

  function startLoading() {
    if (!bar) return;
    // Always clean first — prevents stacking if rapid nav happens
    cleanTimers();

    loadingTimeout = window.setTimeout(() => {
      progress = 0;
      bar.style.width = '0%';
      bar.classList.remove('complete');
      bar.classList.add('loading');

      interval = window.setInterval(() => {
        if (progress < 70) {
          progress += (70 - progress) * 0.15;
        } else if (progress < 85) {
          progress += 1;
        }
        bar.style.width = `${progress}%`;
      }, 80);
    }, 150);
  }

  function completeLoading() {
    if (!bar) return;
    cleanTimers();

    if (!bar.classList.contains('loading')) return;

    progress = 100;
    bar.style.width = '100%';
    bar.classList.add('complete');

    setTimeout(() => {
      bar.classList.remove('loading', 'complete');
      bar.style.width = '0%';
    }, 500);
  }

  // Register ONCE — module scripts in Astro are only executed once,
  // so these listeners won't duplicate across page transitions.
  document.addEventListener('astro:before-preparation', startLoading);
  document.addEventListener('astro:page-load', completeLoading);
</script>
