---
import RecentlyRead from "./RecentlyRead.astro";
import NowStatus from "./NowStatus.astro";
import "@styles/personality-tags-flow.css";
import { equipmentItems } from "@data/equipment";
import { techStackItems } from "@data/tech-stack";

import { profileLabels, hobbyContent } from "@data/profile";

const locale = Astro.currentLocale || "zh";
const labels = profileLabels;

const t = labels[locale as keyof typeof labels] || labels.zh;

const hobbyIcons = {
  feather: "/svg/misc/feather.svg",
  palette: "/svg/misc/palette.svg",
  bird: "/svg/misc/canary.svg",
  paw: "/svg/misc/paw.svg",
};

const hobby = hobbyContent[locale as keyof typeof hobbyContent] || hobbyContent.zh;

const cardLinks = {
  zh: {
    istp: "https://zh.wikipedia.org/wiki/ISTP",
    networking: "https://zh.wikipedia.org/wiki/计算机网络",
    infosec: "https://zh.wikipedia.org/wiki/信息安全",
    hfa: "https://zh.wikipedia.org/wiki/人际关系",
  },
  en: {
    istp: "https://en.wikipedia.org/wiki/ISTP",
    networking: "https://en.wikipedia.org/wiki/Computer_network_engineering",
    infosec: "https://en.wikipedia.org/wiki/Information_security",
    hfa: "https://en.wikipedia.org/wiki/Interpersonal_relationship",
  },
};

const links = cardLinks[locale as keyof typeof cardLinks] || cardLinks.zh;

const sitePages = {
  zh: {
    istp: {
      title: "ISTP - 维基百科，自由的百科全书",
      host: "zh.wikipedia.org",
      url: links.istp,
    },
    networking: {
      title: "计算机网络 - 维基百科，自由的百科全书",
      host: "zh.wikipedia.org",
      url: links.networking,
    },
    infosec: {
      title: "信息安全 - 维基百科，自由的百科全书",
      host: "zh.wikipedia.org",
      url: links.infosec,
    },
    hfa: {
      title: "人际关系 - 维基百科，自由的百科全书",
      host: "zh.wikipedia.org",
      url: links.hfa,
    },
  },
  en: {
    istp: {
      title: "ISTP - Wikipedia",
      host: "en.wikipedia.org",
      url: links.istp,
    },
    networking: {
      title: "Computer network engineering - Wikipedia",
      host: "en.wikipedia.org",
      url: links.networking,
    },
    infosec: {
      title: "Information security - Wikipedia",
      host: "en.wikipedia.org",
      url: links.infosec,
    },
    hfa: {
      title: "Interpersonal relationship - Wikipedia",
      host: "en.wikipedia.org",
      url: links.hfa,
    },
  },
};

const site = sitePages[locale as keyof typeof sitePages] || sitePages.zh;
---

<div class="personality-flow-container">
  <div class="section-head">
    <h2 class="section-title">{t.title}</h2>
    <p class="section-lead">{t.lead}</p>
  </div>

  <div class="bento-grid">
    <!-- Now Card: what I'm currently doing (replaces the old MBTI card) -->
    <NowStatus />

    <!-- Motto Card: click to toggle between motto and diary -->
    <button class="card card--motto" id="motto-card" type="button" aria-expanded="false">
      <!-- Face A: motto -->
      <div class="motto-face motto-face--front">
        <p class="kicker">{t.motto}</p>
        <div class="motto-inner">
          <blockquote class="motto-text">{t.mottoText}</blockquote>
          <p class="motto-foot">{t.mottoFoot}</p>
        </div>
      </div>
      <!-- Face B: diary text only -->
      <div class="motto-face motto-face--back" aria-hidden="true">
        <div class="diary-scroll">
          {
            t.diaryLines.map((line, i) => (
              <p class={i === 2 ? "diary-p diary-highlight" : "diary-p"}>
                {line}
              </p>
            ))
          }
        </div>
      </div>
      <span class="bg-quote" aria-hidden="true">"</span>
    </button>

    <!-- Reading Card: book cover fills card below text, no side-by-side layout -->
    <article class="card card--reading">
      <div class="reading-info">
        <p class="kicker">{t.reading}</p>
        <p class="reading-desc-text">{t.readingDesc}</p>
      </div>
      <div class="reading-cover-wrap">
        <RecentlyRead limit={1} />
      </div>
    </article>

    <!-- Major Card -->
    <article class="card card--major card--link card--site" id="major-site-card">
      <div class="site-card-face site-card-face--front" data-card-front>
        <div class="trait-copy">
          <p class="kicker">{t.major}</p>
          <h3>{t.majorText}</h3>
          <p class="detail">{t.majorDesc}</p>
        </div>
        <span class="trait-illustration" aria-hidden="true">
          <svg
            class="trait-bg-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path
              d="M5 13a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v6a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2v-6"
            ></path>
            <path d="M11 16a1 1 0 1 0 2 0a1 1 0 0 0 -2 0"></path>
            <path d="M8 11v-4a4 4 0 1 1 8 0v4"></path>
          </svg>
        </span>
        <button
          class="site-open-button"
          type="button"
          data-card-open
          aria-expanded="false"
          aria-label={`${t.viewerOpen}: ${site.infosec.title}`}
        >
          <span class="viewer-corner" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="4" y="5" width="16" height="14" rx="3"></rect>
              <path d="M4 9h16"></path>
              <path d="M8 7h.01"></path>
              <path d="M11 7h.01"></path>
            </svg>
          </span>
        </button>
      </div>

      <div class="site-card-face site-card-face--back" data-card-back aria-hidden="true">
        <div class="site-window-chrome">
          <span class="site-window-dots" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
          <div class="site-window-bar">
            <span class="site-window-host">{site.infosec.host}</span>
            <p class="site-window-title">{site.infosec.title}</p>
          </div>
          <div class="site-window-actions">
            <a
              href={site.infosec.url}
              target="_blank"
              rel="noopener noreferrer"
              class="site-window-link"
              aria-label={`${t.viewerOpen}: ${site.infosec.title}`}
            >
              ↗
            </a>
            <button
              class="site-window-close"
              type="button"
              data-card-close
              aria-label={`${t.viewerClose}: ${site.infosec.title}`}
            >
              ×
            </button>
          </div>
        </div>
        <div class="site-window-frame">
          <iframe
            class="site-window-iframe"
            data-site-frame
            data-site-src={site.infosec.url}
            title={site.infosec.title}
            loading="lazy"
          ></iframe>
        </div>
      </div>
    </article>

    <!-- Hobby Card -->
    <button
      class="card card--interest card--hobby"
      id="hobby-card"
      type="button"
      data-state="front"
      aria-expanded="false"
      aria-label={`${t.interests}: ${hobby.title}`}
    >
      <!-- Face 1: front overview -->
      <div class="hobby-face hobby-face--front">
        <div class="trait-copy hobby-copy">
          <p class="kicker">{t.interests}</p>
          <h3>{hobby.title}</h3>
        </div>

        <div class="hobby-art" aria-hidden="true">
          <span class="hobby-art-glow"></span>
          <ul class="hobby-icon-grid">
            {hobby.lines.map((item) => (
              <li class:list={["hobby-icon-cell", `hobby-icon-cell--${item.key}`]}>
                <img
                  src={hobbyIcons[item.key as keyof typeof hobbyIcons]}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="hobby-icon"
                />
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Face 2: hobby list -->
      <div class="hobby-face hobby-face--back" aria-hidden="true">
        <p class="kicker">{t.interests}</p>

        <ul class="hobby-list" role="list">
          {hobby.lines.map((item) => (
            <li class="hobby-list-item">
              <span class:list={["hobby-list-icon", `hobby-list-icon--${item.key}`]} aria-hidden="true">
                <img
                  src={hobbyIcons[item.key as keyof typeof hobbyIcons]}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="hobby-icon hobby-icon--list"
                />
              </span>
              <span class="hobby-list-text">{item.text}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Face 3: equipment (minimal placeholder — full list lives in the popover) -->
      <div class="hobby-face hobby-face--equip" aria-hidden="true">
        <p class="kicker">{t.equipment}</p>
        <h3 class="equip-title">{t.equipmentText}</h3>
      </div>
    </button>

    <!-- Current State Card -->
    <button class="card card--current" id="current-card" type="button" aria-expanded="false">
      <div class="current-face current-face--front">
        <div class="stack-head">
          <h3>{t.currentText}</h3>
          <p class="detail">{t.currentDesc}</p>
        </div>
        <ul class="stack-cloud" role="list" aria-label={t.currentText}>
          {techStackItems.map((item) => (
            <li>
              <span class="stack-link" aria-label={item.name} title={item.name}>
                <img
                  src={item.src}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class:list={["stack-icon", item.external && "stack-icon--external"]}
                />
              </span>
            </li>
          ))}
        </ul>
      </div>

      <div class="current-face current-face--back" aria-hidden="true">
        <div class="chart-panel">
          <p class="kicker">{t.currentChart}</p>
          <div class="chart-shell">
            <img
              src="/examples/activity.svg"
              alt={t.currentChart}
              loading="lazy"
              decoding="async"
              class="github-chart"
            />
          </div>
        </div>
      </div>
    </button>

    <!-- Social Card -->
    <article class="card card--social card--link card--site" id="social-site-card">
      <div class="site-card-face site-card-face--front site-card-face--front-social" data-card-front>
        <div class="wide-copy">
          <p class="kicker">{t.social}</p>
          <h3>{t.socialText}</h3>
          <p class="detail">{t.socialDesc}</p>
        </div>
        <ul class="chips">
          {t.socialTraits.map((tag) => <li>{tag}</li>)}
        </ul>
        <svg
          class="bg-icon"
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.35"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
          <path
            d="M16 18a2 2 0 0 1 2 2a2 2 0 0 1 2 -2a2 2 0 0 1 -2 -2a2 2 0 0 1 -2 2"
          ></path>
          <path
            d="M16 6a2 2 0 0 1 2 2a2 2 0 0 1 2 -2a2 2 0 0 1 -2 -2a2 2 0 0 1 -2 2"
          ></path>
          <path
            d="M9 18a6 6 0 0 1 6 -6a6 6 0 0 1 -6 -6a6 6 0 0 1 -6 6a6 6 0 0 1 6 6"
          ></path>
        </svg>
        <button
          class="site-open-button"
          type="button"
          data-card-open
          aria-expanded="false"
          aria-label={`${t.viewerOpen}: ${site.hfa.title}`}
        >
          <span class="viewer-corner" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="4" y="5" width="16" height="14" rx="3"></rect>
              <path d="M4 9h16"></path>
              <path d="M8 7h.01"></path>
              <path d="M11 7h.01"></path>
            </svg>
          </span>
        </button>
      </div>

      <div class="site-card-face site-card-face--back" data-card-back aria-hidden="true">
        <div class="site-window-chrome">
          <span class="site-window-dots" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
          <div class="site-window-bar">
            <span class="site-window-host">{site.hfa.host}</span>
            <p class="site-window-title">{site.hfa.title}</p>
          </div>
          <div class="site-window-actions">
            <a
              href={site.hfa.url}
              target="_blank"
              rel="noopener noreferrer"
              class="site-window-link"
              aria-label={`${t.viewerOpen}: ${site.hfa.title}`}
            >
              ↗
            </a>
            <button
              class="site-window-close"
              type="button"
              data-card-close
              aria-label={`${t.viewerClose}: ${site.hfa.title}`}
            >
              ×
            </button>
          </div>
        </div>
        <div class="site-window-frame">
          <iframe
            class="site-window-iframe"
            data-site-frame
            data-site-src={site.hfa.url}
            title={site.hfa.title}
            loading="lazy"
          ></iframe>
        </div>
      </div>
    </article>
  </div>

  <!-- Equipment Popover (position: fixed, anchored to hobby card via JS) -->
  <div
    class="equip-popover"
    id="equip-popover"
    role="dialog"
    aria-modal="false"
    aria-hidden="true"
    aria-label={t.equipmentText}
    data-direction="down"
  >
    <div class="equip-popover-inner">
      <div class="equip-popover-head">
        <div class="equip-popover-title-group">
          <p class="kicker">{t.equipment}</p>
          <p class="equip-popover-title">{t.equipmentText}</p>
        </div>
        <button
          class="equip-popover-close"
          type="button"
          aria-label={locale === "zh" ? "关闭设备列表" : "Close device list"}
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <ul class="equip-popover-grid" role="list">
        {equipmentItems.map((item) => (
          <li class="equip-item">
            <span class="equip-logo-wrap" aria-hidden="true">
              <img
                src={item.src}
                alt=""
                loading="lazy"
                decoding="async"
                class:list={["equip-logo", item.external && "equip-logo--external"]}
              />
            </span>
            <span class="equip-name">{item.name}</span>
            <span class="equip-label">{item.label[locale as keyof typeof item.label]}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="equip-popover-arrow" aria-hidden="true"></div>
  </div>
</div>

<script>
  import { animate, stagger, createAnimatable, createSpring } from "animejs";

  document.addEventListener("astro:page-load", () => {
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const finePointer = window.matchMedia("(pointer: fine)");

    const setupPointerGlow = () => {
      document.querySelectorAll(".personality-flow-container .card").forEach((card) => {
        const element = card as HTMLElement;
        if (element.dataset.glowBound === "true") return;

        element.dataset.glowBound = "true";

        const updateGlow = (event: PointerEvent) => {
          if (!finePointer.matches || prefersReducedMotion.matches) return;

          const rect = element.getBoundingClientRect();
          const x = event.clientX - rect.left;
          const y = event.clientY - rect.top;

          element.style.setProperty("--glow-x", `${x}px`);
          element.style.setProperty("--glow-y", `${y}px`);
          element.style.setProperty("--glow-opacity", "1");
        };

        element.addEventListener("pointerenter", updateGlow);
        element.addEventListener("pointermove", updateGlow);
        element.addEventListener("pointerleave", () => {
          element.style.setProperty("--glow-opacity", "0");
        });
      });
    };

    const setupToggleCard = ({
      id,
      toggledClass,
      frontSelector,
      backSelector,
    }: {
      id: string;
      toggledClass: string;
      frontSelector: string;
      backSelector: string;
    }) => {
      const card = document.getElementById(id);
      if (!card || card.dataset.bound === "true") return;

      const front = card.querySelector(frontSelector) as HTMLElement | null;
      const back = card.querySelector(backSelector) as HTMLElement | null;

      card.dataset.bound = "true";
      card.addEventListener("click", () => {
        const isExpanded = card.classList.toggle(toggledClass);
        card.setAttribute("aria-expanded", String(isExpanded));
        if (front) front.setAttribute("aria-hidden", String(isExpanded));
        if (back) back.setAttribute("aria-hidden", String(!isExpanded));
      });
    };

    const setupSiteCard = (id: string) => {
      const card = document.getElementById(id);
      if (!card || card.dataset.bound === "true") return;

      const front = card.querySelector("[data-card-front]") as HTMLElement | null;
      const back = card.querySelector("[data-card-back]") as HTMLElement | null;
      const openButton = card.querySelector("[data-card-open]") as HTMLButtonElement | null;
      const closeButton = card.querySelector("[data-card-close]") as HTMLButtonElement | null;
      const frame = card.querySelector("[data-site-frame]") as HTMLIFrameElement | null;
      const chrome = card.querySelector(".site-window-chrome") as HTMLElement | null;

      const setOpen = (isOpen: boolean) => {
        card.classList.toggle("is-window", isOpen);
        if (front) front.setAttribute("aria-hidden", String(isOpen));
        if (back) back.setAttribute("aria-hidden", String(!isOpen));
        if (openButton) openButton.setAttribute("aria-expanded", String(isOpen));

        if (isOpen && frame && !frame.src) {
          const src = frame.dataset.siteSrc;
          if (src) frame.src = src;
        }
      };

      card.dataset.bound = "true";
      openButton?.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();
        setOpen(!card.classList.contains("is-window"));
      });

      closeButton?.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();
        setOpen(false);
      });

      chrome?.addEventListener("click", (event) => {
        const target = event.target as HTMLElement;
        if (target.closest(".site-window-link") || target.closest(".site-window-close")) return;
        setOpen(false);
      });
    };

    setupToggleCard({
      id: "motto-card",
      toggledClass: "is-diary",
      frontSelector: ".motto-face--front",
      backSelector: ".motto-face--back",
    });

    setupToggleCard({
      id: "current-card",
      toggledClass: "is-chart",
      frontSelector: ".current-face--front",
      backSelector: ".current-face--back",
    });

    // ─── Hobby card: 3-state cycle (front → list → equip → front)
    // equip state opens a fixed popover instead of rendering grid inside the card
    const hobbyCard = document.getElementById("hobby-card");
    const equipPopover = document.getElementById("equip-popover") as HTMLElement | null;

    if (hobbyCard && hobbyCard.dataset.bound !== "true") {
      hobbyCard.dataset.bound = "true";

      const faceFront = hobbyCard.querySelector(".hobby-face--front") as HTMLElement | null;
      const faceBack = hobbyCard.querySelector(".hobby-face--back") as HTMLElement | null;
      const faceEquip = hobbyCard.querySelector(".hobby-face--equip") as HTMLElement | null;
      const popoverCloseBtn = equipPopover?.querySelector(".equip-popover-close") as HTMLButtonElement | null;

      const states = ["front", "list", "equip"] as const;
      type HobbyState = (typeof states)[number];

      // The popover is position:absolute inside .personality-flow-container
      // (its containing block — the container's `perspective` makes it one),
      // so all coordinates are relative to the container, NOT the viewport.
      // That way it scrolls with the page and stays glued to the card.
      const container = equipPopover?.closest(
        ".personality-flow-container",
      ) as HTMLElement | null;

      const positionPopover = () => {
        if (!equipPopover || !container) return;
        const cardRect = hobbyCard.getBoundingClientRect();
        const boxRect = container.getBoundingClientRect();
        const gap = 12;
        const containerW = container.clientWidth;
        const containerH = container.clientHeight;
        const pw = Math.min(380, window.innerWidth - 24);

        // Card position within the container's coordinate space — constant
        // across scrolling, since both rects shift by the same amount.
        const cardLeft = cardRect.left - boxRect.left;
        const cardTop = cardRect.top - boxRect.top;
        const cardCenterX = cardLeft + cardRect.width / 2;

        const left = Math.max(0, Math.min(cardCenterX - pw / 2, containerW - pw));
        equipPopover.style.width = `${pw}px`;
        equipPopover.style.left = `${left}px`;

        // Arrow points to the centre of the hobby card.
        equipPopover.style.setProperty("--arrow-offset", `${cardCenterX - left}px`);

        // Above the card when there's screen room, otherwise below.
        if (cardRect.top > 340) {
          equipPopover.style.bottom = `${containerH - cardTop + gap}px`;
          equipPopover.style.top = "auto";
          equipPopover.dataset.direction = "down";
        } else {
          equipPopover.style.top = `${cardTop + cardRect.height + gap}px`;
          equipPopover.style.bottom = "auto";
          equipPopover.dataset.direction = "up";
        }
      };

      const openPopover = () => {
        if (!equipPopover) return;
        positionPopover();
        equipPopover.style.display = "block";
        requestAnimationFrame(() => {
          equipPopover.classList.add("is-open");
          equipPopover.setAttribute("aria-hidden", "false");
        });
      };

      const closePopover = () => {
        if (!equipPopover) return;
        equipPopover.classList.remove("is-open");
        equipPopover.setAttribute("aria-hidden", "true");
        equipPopover.addEventListener("transitionend", () => {
          if (!equipPopover.classList.contains("is-open")) {
            equipPopover.style.display = "none";
          }
        }, { once: true });
      };

      const applyState = (state: HobbyState) => {
        hobbyCard.dataset.state = state;
        hobbyCard.setAttribute("aria-expanded", state !== "front" ? "true" : "false");
        if (faceFront) faceFront.setAttribute("aria-hidden", String(state !== "front"));
        if (faceBack) faceBack.setAttribute("aria-hidden", String(state !== "list"));
        if (faceEquip) faceEquip.setAttribute("aria-hidden", String(state !== "equip"));
        hobbyCard.classList.toggle("is-revealed", state === "list");
        hobbyCard.classList.toggle("is-equip", state === "equip");
        if (state === "equip") openPopover();
        else closePopover();
      };

      hobbyCard.addEventListener("click", () => {
        const cur = (hobbyCard.dataset.state as HobbyState) || "front";
        const idx = states.indexOf(cur);
        applyState(states[(idx + 1) % states.length]);
      });

      popoverCloseBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        applyState("front");
      });

      // Close when clicking outside both card and popover
      document.addEventListener("click", (e) => {
        if (hobbyCard.dataset.state !== "equip") return;
        const target = e.target as Node;
        if (!hobbyCard.contains(target) && !equipPopover?.contains(target)) {
          applyState("front");
        }
      });

      // Recompute on resize (layout shifts). No scroll handler needed:
      // the popover is absolutely positioned within the flow container,
      // so it scrolls together with the card as part of the page.
      window.addEventListener("resize", () => {
        if (hobbyCard.dataset.state === "equip") positionPopover();
      }, { passive: true });
    }

    setupSiteCard("major-site-card");
    setupSiteCard("social-site-card");
    setupPointerGlow();

    // ─── Anime.js: 3D Tilt + Entrance Animations ─────────────
    if (!prefersReducedMotion.matches) {
      // ── 3D Card Tilt (createAnimatable) ──────────────────────
      // Only for fine-pointer (mouse) users. Creates a live
      // rotateX/rotateY that tracks the cursor position.
      if (finePointer.matches) {
        document.querySelectorAll(".bento-grid .card").forEach((card) => {
          const el = card as HTMLElement;
          if (el.dataset.tiltBound === "true") return;
          el.dataset.tiltBound = "true";

          const tilt = createAnimatable(el, {
            rotateX: { duration: 350, ease: "out(3)" },
            rotateY: { duration: 350, ease: "out(3)" },
          });

          el.addEventListener("pointermove", (e: PointerEvent) => {
            const rect = el.getBoundingClientRect();
            tilt.rotateX(((e.clientY - rect.top) / rect.height - 0.5) * -6);
            tilt.rotateY(((e.clientX - rect.left) / rect.width - 0.5) * 6);
          });

          el.addEventListener("pointerleave", () => {
            tilt.rotateX(0);
            tilt.rotateY(0);
          });
        });
      }

      // ── Scroll-triggered Entrance Animations ─────────────────
      // Uses IntersectionObserver to fire once when the bento
      // grid first scrolls into view, then disconnects.
      const bentoGrid = document.querySelector<HTMLElement>(".bento-grid");
      if (bentoGrid) {
        const entranceObserver = new IntersectionObserver(
          (entries) => {
            if (!entries[0].isIntersecting) return;
            entranceObserver.disconnect();

            // 1. Cards stagger float-in
            animate(".bento-grid .card", {
              opacity: [0, 1],
              translateY: [28, 0],
              scale: [0.97, 1],
              delay: stagger(65),
              duration: 700,
              ease: "outExpo",
            });

            // 2. Tech stack icons scatter-in (starts 320ms after cards)
            animate(".stack-cloud li", {
              opacity: [0, 1],
              scale: [0.72, 1],
              delay: stagger(18, { from: "random", start: 340 }),
              duration: 420,
              ease: "outBack(1.4)",
            });

            // 3. Social chips spring bounce-in (starts 420ms after cards)
            animate(".chips li", {
              opacity: [0, 1],
              translateX: [18, 0],
              scale: [0.9, 1],
              delay: stagger(80, { start: 440 }),
              duration: 560,
              ease: createSpring({ stiffness: 100, damping: 14 }),
            });
          },
          { threshold: 0.08 },
        );

        entranceObserver.observe(bentoGrid);
      }
    }
  });
</script>
