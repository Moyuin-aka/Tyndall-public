---
import RecentlyRead from "./RecentlyRead.astro";

const locale = Astro.currentLocale || "zh";
const labels = {
  zh: {
    title: "关于我的特质",
    lead: "",
    mbti: "MBTI",
    mbtiDesc: "理性思考者，独立探索",
    mbtiDescLines: ["理性思考者", "独立探索"],
    motto: "底色",
    mottoText: "缥缈，游荡，\n没有来路与归处。",
    mottoFoot: "心之安处是吾乡。",
    diaryLines: [
      "今日虽然严寒，但看见窗外银杏的新芽长出来了，不由得十分欢喜。我看雪与冰渣在风雨的起伏中吹动，陨落于大地，再也回不到不属于它们的天空与枝头。",
      "可它们在新年的太阳下慢慢化为水，回到了树木的茎脉中，重新作用，或蒸腾为水，或光合生氧，滋润回银杏树的初芽中。",
      "也许我也会这样吧。不敢说自己是滋润万物的水，补益生态的氧气，只是觉得自己飘零无归处，但世界总会有一天需要我的。",
      "当然，做普照万世的太阳也挺好。这样，心之安处是吾乡，成为自己内心的太阳，我又靠着自己的一双胳膊向前走去了。",
    ],
    reading: "最近在读",
    readingDesc: "最近翻来覆去的一本。",
    interests: "职业兴趣",
    interestsText: "网络工程",
    interestsDesc: "实现网络功能与协议",
    major: "所学专业",
    majorText: "信息安全",
    majorDesc: "网络安全与密码学",
    social: "社交",
    socialText: "HFA 倾向",
    socialDesc: "社交能量有限，但仍然认真相待。",
    socialTraits: ["慢热", "真诚", "低社交电量"],
    current: "最近学过",
    currentText: "技术栈",
    currentDesc: "平时的折腾。",
    currentChart: "GitHub 活动",
    viewerOpen: "打开原页",
    viewerClose: "收起",
  },
  en: {
    title: "About My Traits",
    lead: "",
    mbti: "MBTI",
    mbtiDesc: "Rational thinker, independent explorer",
    mbtiDescLines: ["Rational thinker", "independent explorer"],
    motto: "Core Tone",
    mottoText: "Floating or hovering,\nno origin and no destination.",
    mottoFoot: "Home is where the heart settles.",
    diaryLines: [
      "Though bitterly cold today, I spotted new buds on the ginkgo outside the window, and felt a quiet joy. I watched snow and sleet tossed by the wind, falling to the ground, never to return to the sky or branches that were never really theirs.",
      "Yet beneath the new year's sun they slowly melted into water, finding their way back into the tree's veins — becoming vapour, becoming oxygen, returning to the boundless world, nourishing the ginkgo's first buds.",
      "Perhaps I am like that too. I wouldn't dare call myself life-giving water or vital oxygen — only that I feel untethered, drifting without destination. But I believe the world will one day need even me.",
      "Then again, to be the sun that warms all ages would also be fine. So: home is where the heart settles, become the sun of your own inner world — and I set off again, on my own two arms.",
    ],
    reading: "Currently Reading",
    readingDesc: "On repeat lately.",
    interests: "Interests",
    interestsText: "Network Engineering",
    interestsDesc: "Implementing network functions",
    major: "Major",
    majorText: "Information Security",
    majorDesc: "Cybersecurity and cryptography",
    social: "Social",
    socialText: "HFA-inclined",
    socialDesc: "Limited social energy, but earnest in how I show up.",
    socialTraits: ["quiet", "sincere", "low battery"],
    current: "Currently",
    currentText: "Tech Stack",
    currentDesc: "Things I write, break, and keep tinkering with.",
    currentChart: "GitHub Activity",
    viewerOpen: "Open Page",
    viewerClose: "Hide",
  },
};

const t = labels[locale as keyof typeof labels] || labels.zh;

const stackIcons = [
  { name: "C++", slug: "cplusplus", href: "https://isocpp.org/" },
  { name: "Python", slug: "python", href: "https://www.python.org/" },
  { name: "PHP", slug: "php", href: "https://www.php.net/" },
  { name: "Rust", slug: "rust", href: "https://www.rust-lang.org/" },
  {
    name: "HTML5",
    slug: "html5",
    href: "https://developer.mozilla.org/en-US/docs/Web/Guide/HTML/HTML5",
  },
  {
    name: "CSS3",
    slug: "css",
    href: "https://developer.mozilla.org/en-US/docs/Web/CSS",
  },
  {
    name: "JavaScript",
    slug: "javascript",
    href: "https://developer.mozilla.org/en-US/docs/Web/JavaScript",
  },
  {
    name: "TypeScript",
    slug: "typescript",
    href: "https://developer.mozilla.org/en-US/docs/Glossary/TypeScript",
  },
  { name: "Astro", slug: "astro", href: "https://astro.build/" },
  { name: "Swift", slug: "swift", href: "https://swift.org/" },
  { name: "Docker", slug: "docker", href: "https://www.docker.com/" },
  { name: "Caddy", slug: "caddy", href: "https://caddyserver.com/" },
  { name: "Supabase", slug: "supabase", href: "https://supabase.com/" },
  {
    name: "GitHub Actions",
    slug: "githubactions",
    href: "https://github.com/features/actions",
  },
  { name: "Vercel", slug: "vercel", href: "https://vercel.com/" },
  {
    name: "Cloudflare Tunnel",
    slug: "cloudflare",
    href: "https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/",
  },
  { name: "MySQL", slug: "mysql", href: "https://www.mysql.com/" },
  { name: "SQLite", slug: "sqlite", href: "https://www.sqlite.org/" },
  { name: "MongoDB", slug: "mongodb", href: "https://www.mongodb.com/" },
  {
    name: "PostgreSQL",
    slug: "postgresql",
    href: "https://www.postgresql.org/",
  },
  { name: "Redis", slug: "redis", href: "https://redis.io/" },
  {
    name: "Xray",
    src: "https://api.iconify.design/mdi/star-four-points.svg?color=%23000",
    href: "https://github.com/XTLS/Xray-core",
  },
  {
    name: "Sing-box",
    src: "https://upload.wikimedia.org/wikipedia/commons/1/11/Sing-box.svg",
    href: "https://sing-box.sagernet.org/",
  },
  {
    name: "Hysteria 2",
    src: "https://upload.wikimedia.org/wikipedia/commons/b/b4/Hysteria_2_Logo.svg",
    href: "https://v2.hysteria.network/zh/",
  },
  {
    name: "IPv6",
    src: "https://api.iconify.design/mdi/ip-network-outline.svg?color=%23000",
    href: "https://ipv6.com/",
  },
  {
    name: "WireGuard",
    slug: "wireguard",
    href: "https://www.wireguard.com/",
  },
  {
    name: "Tailscale",
    slug: "tailscale",
    href: "https://tailscale.com/",
  },
  {
    name: "OpenWrt",
    slug: "openwrt",
    href: "https://openwrt.org/",
  },
  {
    name: "Padavan",
    src: "https://api.iconify.design/ic/outline-router.svg?color=%23000",
    href: "https://bitbucket.org/padavan/rt-n56u/",
  },
  {
    name: "Wireshark",
    slug: "wireshark",
    href: "https://wireshark.com/",
  },
];

const cardLinks = {
  zh: {
    istp: "https://zh.wikipedia.org/wiki/ISTP",
    networking: "https://zh.wikipedia.org/wiki/计算机网络",
    infosec: "https://zh.wikipedia.org/wiki/信息安全",
    hfa: "https://zh.wikipedia.org/wiki/高功能自閉症",
  },
  en: {
    istp: "https://en.wikipedia.org/wiki/ISTP",
    networking: "https://en.wikipedia.org/wiki/Computer_network_engineering",
    infosec: "https://en.wikipedia.org/wiki/Information_security",
    hfa: "https://en.wikipedia.org/wiki/High-functioning_autism",
  },
};

const links = cardLinks[locale as keyof typeof cardLinks] || cardLinks.zh;

const sitePages = {
  zh: {
    istp: {
      title: "ISTP - 维基百科，自由的百科全书",
      host: "zh.wikipedia.org",
      url: links.istp,
    },
    networking: {
      title: "计算机网络 - 维基百科，自由的百科全书",
      host: "zh.wikipedia.org",
      url: links.networking,
    },
    infosec: {
      title: "信息安全 - 维基百科，自由的百科全书",
      host: "zh.wikipedia.org",
      url: links.infosec,
    },
    hfa: {
      title: "高功能自閉症 - 维基百科，自由的百科全书",
      host: "zh.wikipedia.org",
      url: links.hfa,
    },
  },
  en: {
    istp: {
      title: "ISTP - Wikipedia",
      host: "en.wikipedia.org",
      url: links.istp,
    },
    networking: {
      title: "Computer network engineering - Wikipedia",
      host: "en.wikipedia.org",
      url: links.networking,
    },
    infosec: {
      title: "Information security - Wikipedia",
      host: "en.wikipedia.org",
      url: links.infosec,
    },
    hfa: {
      title: "High-functioning autism - Wikipedia",
      host: "en.wikipedia.org",
      url: links.hfa,
    },
  },
};

const site = sitePages[locale as keyof typeof sitePages] || sitePages.zh;
---

<div class="personality-flow-container">
  <div class="section-head">
    <h2 class="section-title">{t.title}</h2>
    <p class="section-lead">{t.lead}</p>
  </div>

  <div class="bento-grid">
    <!-- MBTI Card -->
    <article class="card card--mbti card--link card--site" id="mbti-site-card">
      <div class="site-card-face site-card-face--front" data-card-front>
        <div class="mbti-top">
          <p class="kicker">{t.mbti}</p>
          <h3 class="mbti-title">ISTP</h3>
          <p class="detail mbti-detail">
            {t.mbtiDescLines.map((line, index) => (
              <>
                {index > 0 && (
                  <span class="mbti-separator" aria-hidden="true">
                    {locale === "zh" ? "，" : ","}
                  </span>
                )}
                <span class="mbti-detail-line">{line}</span>
              </>
            ))}
          </p>
        </div>
        <img src="/svg/istp.svg" alt="ISTP" class="mbti-img" />
        <button
          class="site-open-button"
          type="button"
          data-card-open
          aria-expanded="false"
          aria-label={`${t.viewerOpen}: ${site.istp.title}`}
        >
          <span class="viewer-corner" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="4" y="5" width="16" height="14" rx="3"></rect>
              <path d="M4 9h16"></path>
              <path d="M8 7h.01"></path>
              <path d="M11 7h.01"></path>
            </svg>
          </span>
        </button>
      </div>

      <div class="site-card-face site-card-face--back" data-card-back aria-hidden="true">
        <div class="site-window-chrome">
          <span class="site-window-dots" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
          <div class="site-window-bar">
            <span class="site-window-host">{site.istp.host}</span>
            <p class="site-window-title">{site.istp.title}</p>
          </div>
          <div class="site-window-actions">
            <a
              href={site.istp.url}
              target="_blank"
              rel="noopener noreferrer"
              class="site-window-link"
              aria-label={`${t.viewerOpen}: ${site.istp.title}`}
            >
              ↗
            </a>
            <button
              class="site-window-close"
              type="button"
              data-card-close
              aria-label={`${t.viewerClose}: ${site.istp.title}`}
            >
              ×
            </button>
          </div>
        </div>
        <div class="site-window-frame">
          <iframe
            class="site-window-iframe"
            data-site-frame
            data-site-src={site.istp.url}
            title={site.istp.title}
            loading="lazy"
          ></iframe>
        </div>
      </div>
    </article>

    <!-- Motto Card: click to toggle between motto and diary -->
    <button class="card card--motto" id="motto-card" type="button" aria-expanded="false">
      <!-- Face A: motto -->
      <div class="motto-face motto-face--front">
        <p class="kicker">{t.motto}</p>
        <div class="motto-inner">
          <blockquote class="motto-text">{t.mottoText}</blockquote>
          <p class="motto-foot">{t.mottoFoot}</p>
        </div>
      </div>
      <!-- Face B: diary text only -->
      <div class="motto-face motto-face--back" aria-hidden="true">
        <div class="diary-scroll">
          {
            t.diaryLines.map((line, i) => (
              <p class={i === 2 ? "diary-p diary-highlight" : "diary-p"}>
                {line}
              </p>
            ))
          }
        </div>
      </div>
      <span class="bg-quote" aria-hidden="true">"</span>
    </button>

    <!-- Reading Card: book cover fills card below text, no side-by-side layout -->
    <article class="card card--reading">
      <div class="reading-info">
        <p class="kicker">{t.reading}</p>
        <p class="reading-desc-text">{t.readingDesc}</p>
      </div>
      <div class="reading-cover-wrap">
        <RecentlyRead limit={1} />
      </div>
    </article>

    <!-- Major Card -->
    <article class="card card--major card--link card--site" id="major-site-card">
      <div class="site-card-face site-card-face--front" data-card-front>
        <div class="trait-copy">
          <p class="kicker">{t.major}</p>
          <h3>{t.majorText}</h3>
          <p class="detail">{t.majorDesc}</p>
        </div>
        <span class="trait-illustration" aria-hidden="true">
          <svg
            class="trait-bg-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path
              d="M5 13a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v6a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2v-6"
            ></path>
            <path d="M11 16a1 1 0 1 0 2 0a1 1 0 0 0 -2 0"></path>
            <path d="M8 11v-4a4 4 0 1 1 8 0v4"></path>
          </svg>
        </span>
        <button
          class="site-open-button"
          type="button"
          data-card-open
          aria-expanded="false"
          aria-label={`${t.viewerOpen}: ${site.infosec.title}`}
        >
          <span class="viewer-corner" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="4" y="5" width="16" height="14" rx="3"></rect>
              <path d="M4 9h16"></path>
              <path d="M8 7h.01"></path>
              <path d="M11 7h.01"></path>
            </svg>
          </span>
        </button>
      </div>

      <div class="site-card-face site-card-face--back" data-card-back aria-hidden="true">
        <div class="site-window-chrome">
          <span class="site-window-dots" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
          <div class="site-window-bar">
            <span class="site-window-host">{site.infosec.host}</span>
            <p class="site-window-title">{site.infosec.title}</p>
          </div>
          <div class="site-window-actions">
            <a
              href={site.infosec.url}
              target="_blank"
              rel="noopener noreferrer"
              class="site-window-link"
              aria-label={`${t.viewerOpen}: ${site.infosec.title}`}
            >
              ↗
            </a>
            <button
              class="site-window-close"
              type="button"
              data-card-close
              aria-label={`${t.viewerClose}: ${site.infosec.title}`}
            >
              ×
            </button>
          </div>
        </div>
        <div class="site-window-frame">
          <iframe
            class="site-window-iframe"
            data-site-frame
            data-site-src={site.infosec.url}
            title={site.infosec.title}
            loading="lazy"
          ></iframe>
        </div>
      </div>
    </article>

    <!-- Interest Card -->
    <article class="card card--interest card--link card--site" id="interest-site-card">
      <div class="site-card-face site-card-face--front" data-card-front>
        <div class="trait-copy">
          <p class="kicker">{t.interests}</p>
          <h3>{t.interestsText}</h3>
          <p class="detail">{t.interestsDesc}</p>
        </div>
        <span class="trait-illustration" aria-hidden="true">
          <svg
            class="trait-bg-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"></path>
            <path d="M3.6 9h16.8"></path>
            <path d="M3.6 15h16.8"></path>
            <path d="M11.5 3a17 17 0 0 0 0 18"></path>
            <path d="M12.5 3a17 17 0 0 1 0 18"></path>
          </svg>
        </span>
        <button
          class="site-open-button"
          type="button"
          data-card-open
          aria-expanded="false"
          aria-label={`${t.viewerOpen}: ${site.networking.title}`}
        >
          <span class="viewer-corner" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="4" y="5" width="16" height="14" rx="3"></rect>
              <path d="M4 9h16"></path>
              <path d="M8 7h.01"></path>
              <path d="M11 7h.01"></path>
            </svg>
          </span>
        </button>
      </div>

      <div class="site-card-face site-card-face--back" data-card-back aria-hidden="true">
        <div class="site-window-chrome">
          <span class="site-window-dots" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
          <div class="site-window-bar">
            <span class="site-window-host">{site.networking.host}</span>
            <p class="site-window-title">{site.networking.title}</p>
          </div>
          <div class="site-window-actions">
            <a
              href={site.networking.url}
              target="_blank"
              rel="noopener noreferrer"
              class="site-window-link"
              aria-label={`${t.viewerOpen}: ${site.networking.title}`}
            >
              ↗
            </a>
            <button
              class="site-window-close"
              type="button"
              data-card-close
              aria-label={`${t.viewerClose}: ${site.networking.title}`}
            >
              ×
            </button>
          </div>
        </div>
        <div class="site-window-frame">
          <iframe
            class="site-window-iframe"
            data-site-frame
            data-site-src={site.networking.url}
            title={site.networking.title}
            loading="lazy"
          ></iframe>
        </div>
      </div>
    </article>

    <!-- Current State Card -->
    <button class="card card--current" id="current-card" type="button" aria-expanded="false">
      <div class="current-face current-face--front">
        <div class="stack-head">
          <h3>{t.currentText}</h3>
          <p class="detail">{t.currentDesc}</p>
        </div>
        <ul class="stack-cloud" role="list" aria-label={t.currentText}>
          {stackIcons.map((item) => (
            <li>
              <span class="stack-link" aria-label={item.name} title={item.name}>
                <img
                  src={item.src ?? `https://cdn.simpleicons.org/${item.slug}/000?viewbox=auto`}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class:list={["stack-icon", item.src && "stack-icon--external"]}
                />
              </span>
            </li>
          ))}
        </ul>
      </div>

      <div class="current-face current-face--back" aria-hidden="true">
        <div class="chart-panel">
          <p class="kicker">{t.currentChart}</p>
          <div class="chart-shell">
            <img
              src="https://ghchart.rshah.org/moyuin-aka"
              alt={t.currentChart}
              loading="lazy"
              decoding="async"
              class="github-chart"
            />
          </div>
        </div>
      </div>
    </button>

    <!-- Social Card -->
    <article class="card card--social card--link card--site" id="social-site-card">
      <div class="site-card-face site-card-face--front site-card-face--front-social" data-card-front>
        <div class="wide-copy">
          <p class="kicker">{t.social}</p>
          <h3>{t.socialText}</h3>
          <p class="detail">{t.socialDesc}</p>
        </div>
        <ul class="chips">
          {t.socialTraits.map((tag) => <li>{tag}</li>)}
        </ul>
        <svg
          class="bg-icon"
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.35"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
          <path
            d="M16 18a2 2 0 0 1 2 2a2 2 0 0 1 2 -2a2 2 0 0 1 -2 -2a2 2 0 0 1 -2 2"
          ></path>
          <path
            d="M16 6a2 2 0 0 1 2 2a2 2 0 0 1 2 -2a2 2 0 0 1 -2 -2a2 2 0 0 1 -2 2"
          ></path>
          <path
            d="M9 18a6 6 0 0 1 6 -6a6 6 0 0 1 -6 -6a6 6 0 0 1 -6 6a6 6 0 0 1 6 6"
          ></path>
        </svg>
        <button
          class="site-open-button"
          type="button"
          data-card-open
          aria-expanded="false"
          aria-label={`${t.viewerOpen}: ${site.hfa.title}`}
        >
          <span class="viewer-corner" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="4" y="5" width="16" height="14" rx="3"></rect>
              <path d="M4 9h16"></path>
              <path d="M8 7h.01"></path>
              <path d="M11 7h.01"></path>
            </svg>
          </span>
        </button>
      </div>

      <div class="site-card-face site-card-face--back" data-card-back aria-hidden="true">
        <div class="site-window-chrome">
          <span class="site-window-dots" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
          <div class="site-window-bar">
            <span class="site-window-host">{site.hfa.host}</span>
