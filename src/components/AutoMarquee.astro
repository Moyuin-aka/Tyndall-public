---
import { Image } from "astro:assets";
import { favorites } from "@/data/favorites";
import { toAppleMusicEmbedUrl } from "@utils/appleMusic.mjs";

interface Props {
  title?: string;
  items?: any[];
  speedMs?: number;
  rows?: number;
}

const {
  title = "More I Love",
  items,
  speedMs = 28000,
  rows = 1,
} = Astro.props as Props;
const displayItems = items && items.length ? items : favorites;
---

<section class="marquee" role="region" aria-label={title}>
  <header class="header">
    <h3 class="title">{title}</h3>
  </header>

  <div class="rows">
    <div class="fade left" aria-hidden="true"></div>
    <div class="fade right" aria-hidden="true"></div>

    <!-- Row A -->
    <div class="row" data-dir="right" style={`--speed: ${speedMs}ms`}>
      <div class="track">
        {
          displayItems.concat(displayItems).map((it, i) => (
            <a
              class={`tile ${i >= displayItems.length ? "duplicate" : ""}`}
              href={it.href || "#"}
              aria-label={it.name}
              tabindex="0"
              data-idx={i}
              data-embed-url={toAppleMusicEmbedUrl(it.href) || undefined}
              data-embed-title={it.name}
            >
              <div class="cover">
                <Image
                  src={it.image}
                  alt={it.alt || it.name}
                  width={300}
                  height={300}
                  loading="lazy"
                  decoding="async"
                  fetchpriority="low"
                />
              </div>
              <div class="label">
                <span class="name">{it.name}</span>
                {it.subtitle && <span class="sub">{it.subtitle}</span>}
              </div>
            </a>
          ))
        }
      </div>
    </div>
    {
      rows > 1 && (
        <div
          class="row"
          data-dir="left"
          style={`--speed: ${Math.round(speedMs * 0.82)}ms`}
        >
          <div class="track">
            {displayItems.concat(displayItems).map((it, i) => (
              <a
                class={`tile ${i >= displayItems.length ? "duplicate" : ""}`}
                href={it.href || "#"}
                aria-label={it.name}
                tabindex="0"
                data-idx={i}
                data-embed-url={toAppleMusicEmbedUrl(it.href) || undefined}
                data-embed-title={it.name}
              >
                <div class="cover">
                  <Image
                    src={it.image}
                    alt={it.alt || it.name}
                    width={300}
                    height={300}
                    loading="lazy"
                    decoding="async"
                    fetchpriority="low"
                  />
                </div>
                <div class="label">
                  <span class="name">{it.name}</span>
                  {it.subtitle && <span class="sub">{it.subtitle}</span>}
                </div>
              </a>
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>

<script>
  import { createAnimatable } from "animejs";

  // Cleanup for the currently-open player's loading overlay (message
  // listener + fallback timer), so closing mid-load doesn't leak them.
  let amReveal: (() => void) | null = null;

  // Runs on every Astro page-load (View Transitions friendly).
  // Iterates ALL .marquee instances on the page — replaces the
  // old is:inline / currentScript pattern.
  // ── Click-to-play Apple Music modal ──────────────────────────────
  // A single shared player overlay (lazily created, lives on <body> so
  // it survives outside any marquee's scoped DOM). Clicking an album
  // tile opens its embed here instead of navigating off-site.
  function getModal() {
    let modal = document.getElementById("am-player-modal");
    if (modal) return modal;

    modal = document.createElement("div");
    modal.id = "am-player-modal";
    modal.className = "am-modal";
    modal.setAttribute("role", "dialog");
    modal.setAttribute("aria-modal", "true");
    modal.hidden = true;
    modal.innerHTML = `
      <div class="am-modal__backdrop" data-am-close></div>
      <div class="am-modal__card" role="document">
        <button class="am-modal__close" type="button" aria-label="关闭" data-am-close>&times;</button>
        <div class="am-modal__frame"></div>
      </div>`;
    document.body.appendChild(modal);

    const close = () => {
      modal.hidden = true;
      modal.classList.remove("is-open");
      // Tear down the loading overlay's listener/timer if still pending.
      amReveal?.();
      amReveal = null;
      // Removing the iframe stops playback immediately.
      const frame = modal.querySelector(".am-modal__frame");
      if (frame) frame.innerHTML = "";
      document.documentElement.style.removeProperty("overflow");
    };
    modal.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("[data-am-close]")) close();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal!.hidden) close();
    });
    return modal;
  }

  function openPlayer(url: string, title: string) {
    const modal = getModal();
    const frame = modal.querySelector(".am-modal__frame")!;

    // Progress bar covers Apple's blank placeholder while the embed
    // boots (the player takes a few seconds to load MusicKit + auth).
    const loading = document.createElement("div");
    loading.className = "am-modal__loading";
    loading.innerHTML =
      '<div class="am-progress"><span class="am-progress__bar" aria-hidden="true"></span></div>';
    const bar = loading.querySelector(".am-progress__bar") as HTMLElement;

    const iframe = document.createElement("iframe");
    iframe.src = url;
    iframe.title = title || "Apple Music";
    iframe.allow = "autoplay *; encrypted-media *; clipboard-write";
    iframe.setAttribute("frameborder", "0");
    iframe.setAttribute(
      "sandbox",
      "allow-forms allow-popups allow-same-origin allow-scripts allow-storage-access-by-user-activation allow-top-navigation-by-user-activation",
    );

    // The iframe is cross-origin, so we can't read when Apple's player
    // has actually painted. The `load` event fires way too early (the
    // doc loads ~2s before MusicKit finishes booting). Best signal we
    // have is the first postMessage Apple's embed emits once it's live;
    // fall back to a timer so the spinner never sticks if none arrives.
    let revealed = false;
    const reveal = () => {
      window.removeEventListener("message", onMessage);
      clearTimeout(fallback);
      amReveal = null;
      if (revealed) return;
      revealed = true;
      // Snap to 100%, then fade the overlay out.
      bar.style.transition = "width 0.3s ease";
      bar.style.width = "100%";
      setTimeout(() => loading.classList.add("is-done"), 300);
    };
    const onMessage = (e: MessageEvent) => {
      if (e.origin === "https://embed.music.apple.com") reveal();
    };
    window.addEventListener("message", onMessage);
    const fallback = setTimeout(reveal, 6000);
    amReveal = reveal;

    frame.innerHTML = "";
    frame.appendChild(iframe);
    frame.appendChild(loading);
    modal.hidden = false;
    // Next frame so the transition runs.
    requestAnimationFrame(() => {
      modal.classList.add("is-open");
      // Crawl toward 90% (decelerating) — never completes until ready.
      bar.style.width = "90%";
    });
    document.documentElement.style.overflow = "hidden";
  }

  document.addEventListener("astro:page-load", () => {
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );
    const finePointer = window.matchMedia("(pointer: fine)");

    document.querySelectorAll(".marquee").forEach((rootEl) => {
      const root = rootEl as HTMLElement;
      const rowEls = root.querySelectorAll(".row");
      const pause = () => rowEls.forEach((r) => r.classList.add("paused"));
      const resume = () =>
        rowEls.forEach((r) => r.classList.remove("paused"));

      // Only pause on keyboard-focus or touch — NOT on mouse hover,
      // so the marquee keeps scrolling while you tilt individual tiles.
      root.addEventListener("focusin", pause);
      root.addEventListener("focusout", resume);

      // Intercept clicks on embeddable tiles → open in-page player.
      // Guard so View Transitions re-runs don't double-bind.
      if (root.dataset.embedBound !== "true") {
        root.dataset.embedBound = "true";
        root.addEventListener("click", (e) => {
          const tile = (e.target as HTMLElement).closest(
            ".tile",
          ) as HTMLAnchorElement | null;
          if (!tile) return;
          const url = tile.dataset.embedUrl;
          if (!url) return; // no embed → let the link navigate normally
          // Let modifier-clicks (open in new tab) through untouched.
          const me = e as MouseEvent;
          if (me.metaKey || me.ctrlKey || me.shiftKey || me.button !== 0) return;
          e.preventDefault();
          openPlayer(url, tile.dataset.embedTitle || "");
        });
      }

      // Mobile: pause on touch
      let touchTimer = 0;
      root.addEventListener(
        "pointerdown",
        (e: PointerEvent) => {
          if (e.pointerType === "mouse") return;
          pause();
          if (touchTimer) clearTimeout(touchTimer);
          touchTimer = setTimeout(resume, 2200) as unknown as number;
        },
        { passive: true },
      );

      // 3D tilt with createAnimatable — smooth interpolated spring
      if (!prefersReducedMotion.matches && finePointer.matches) {
        root.querySelectorAll(".tile").forEach((tile) => {
          const el = tile as HTMLElement;
          if (el.dataset.tiltBound === "true") return;
          el.dataset.tiltBound = "true";

          // createAnimatable gives each property its own smooth easing
          const tilt = createAnimatable(el, {
            rotateX: { duration: 300, ease: "out(3)" },
            rotateY: { duration: 300, ease: "out(3)" },
          });

          el.addEventListener(
            "pointermove",
            (e: PointerEvent) => {
              const r = el.getBoundingClientRect();
              const dx = (e.clientX - (r.left + r.width / 2)) / r.width;
              const dy = (e.clientY - (r.top + r.height / 2)) / r.height;
              tilt.rotateX(-dy * 9);
              tilt.rotateY(dx * 12);
            },
            { passive: true },
          );

          el.addEventListener("pointerleave", () => {
            tilt.rotateX(0);
            tilt.rotateY(0);
          });
        });
      }
    });
  });
</script>

<style>
  /* Allow narrowing the marquee via CSS var */
  .marquee {
    width: 100%;
    --marquee-max: 960px;
    max-width: var(--marquee-max);
    margin: 0 auto;
    padding: 0 1rem;
    overflow-x: hidden;
    contain: paint;
    box-sizing: border-box;
  }
  .header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.4rem;
  }
  .title {
    margin: 0;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
  }

  .rows {
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    isolation: isolate;
    contain: layout paint;
    box-sizing: border-box;
    /* Perspective here gives each tile the same vanishing point,
       so depth layers on .cover look natural from any position. */
    perspective: 900px;
  }
  .row {
    overflow: hidden;
    mask-image: linear-gradient(
      90deg,
      transparent 0,
      black 10%,
      black 90%,
      transparent 100%
    );
  }

  .track {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.6rem;
    padding: 0.35rem 0 0.7rem;
    width: max-content; /* allow content width for seamless loop */
    box-sizing: border-box;
    will-change: transform; /* isolate animation to compositor */
    justify-content: flex-start;
  }

  /* Animation */
  .row[data-dir="right"] .track {
    animation: marquee-right var(--speed) linear infinite;
  }
  .row[data-dir="left"] .track {
    animation: marquee-left var(--speed) linear infinite;
  }
  .row.paused .track {
    animation-play-state: paused;
  }

  @keyframes marquee-right {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @keyframes marquee-left {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0);
    }
  }

  /* Tiles */
  .tile {
    position: relative;
    display: grid;
    grid-template-rows: auto auto;
    align-content: start;
    width: clamp(140px, 20vw, 200px);
    text-decoration: none;
    color: inherit;
    outline: none;
    filter: drop-shadow(0 8px 18px rgba(0, 0, 0, 0.1));
    transform-style: preserve-3d;
    /* anime.js controls rotateX/Y — only keep filter transition */
    transition: filter 0.18s ease;
  }
  .tile:focus-visible {
    filter: drop-shadow(0 10px 26px rgba(61, 123, 246, 0.42));
  }

  .cover {
    aspect-ratio: 1 / 1;
    border-radius: 14px;
    overflow: hidden;
    background: var(--bg);
    transform: translateZ(0);
    position: relative;

    /* ── Stacked-spine thickness ──────────────────────────────── */
    /* Three layered box-shadows offset right+down simulate       */
    /* the page edges of a CD case / vinyl sleeve.                */
    --spine-1: rgba(0, 0, 0, 0.08);
    --spine-2: rgba(0, 0, 0, 0.05);
    --spine-3: rgba(0, 0, 0, 0.03);
    box-shadow:
      /* base ambient shadow */
      0 1px 6px rgba(0, 0, 0, 0.06),
      /* spine page 1 */
      3px 3px 0 0 var(--spine-1),
      /* spine page 2 */
      6px 6px 0 0 var(--spine-2),
      /* spine page 3 */
      9px 9px 0 0 var(--spine-3);
    transition: box-shadow 0.22s ease;
  }

  /* Dark theme spine colors */
  :global([data-theme="dark"]) .cover {
    --spine-1: rgba(255, 255, 255, 0.06);
    --spine-2: rgba(255, 255, 255, 0.03);
    --spine-3: rgba(255, 255, 255, 0.015);
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .label {
    text-align: center;
    margin-top: 0.45rem;
  }
  .name {
    font-weight: 500;
    font-size: 0.98rem;
  }
  .sub {
    display: block;
    margin-top: 0.12rem;
    font-size: 0.88rem;
    color: var(--grey);
  }

  /* Idle state — anime.js owns rotateX/Y, no CSS var needed */
  .tile {
    transform: none;
  }
  .tile .cover img {
    will-change: transform;
    animation: breathe 6.5s ease-in-out infinite;
  }
  @keyframes breathe {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.02);
    }
  }

  /* Edge fades */
  .fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 36px;
    pointer-events: none;
    z-index: 1;
  }
  .fade.left {
    left: 0;
    background: linear-gradient(90deg, var(--bg) 0%, rgba(0, 0, 0, 0) 100%);
  }
  .fade.right {
    right: 0;
    background: linear-gradient(270deg, var(--bg) 0%, rgba(0, 0, 0, 0) 100%);
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .tile .cover img {
      animation: none;
    }
  }

  @media (max-width: 768px) {
    /* On mobile, display as a responsive grid */
    .duplicate {
      display: none;
    }
    .row {
      mask-image: none;
      width: 100%;
      overflow: hidden;
    }
    .row[data-dir] .track {
      animation: none;
    }
    .row + .row {
      margin-top: 0.75rem;
    }
    .track {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
      gap: 0.6rem;
      padding: 0.35rem 0;
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
      overflow: hidden;
    }
    .tile {
      width: 100%;
      max-width: none;
      filter: drop-shadow(0 6px 12px rgba(0, 0, 0, 0.08));
    }
    .label {
      margin-top: 0.32rem;
    }
    .name {
      display: block;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      font-size: 0.9rem;
    }
    .sub {
      font-size: 0.82rem;
    }
    .fade {
      display: none;
    }
  }
</style>

<!-- Player modal lives on <body>, so its styles must be global. -->
<style is:global>
  .am-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    padding: 1.25rem;
    /* Apple-style scrim: dark, heavily blurred. */
    background: rgba(0, 0, 0, 0.5);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    opacity: 0;
    transition: opacity 0.28s ease;
  }
  .am-modal.is-open {
    opacity: 1;
  }
  .am-modal[hidden] {
    display: none;
  }

  .am-modal__backdrop {
    position: absolute;
    inset: 0;
    cursor: zoom-out;
  }

  .am-modal__card {
    position: relative;
    width: min(100%, 560px);
    transform: translateY(12px) scale(0.98);
    transition:
      transform 0.32s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.28s ease;
    opacity: 0;
  }
  .am-modal.is-open .am-modal__card {
    transform: translateY(0) scale(1);
    opacity: 1;
  }

  .am-modal__frame {
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.45);
    background: transparent;
  }
  .am-modal__frame {
    position: relative;
  }
  .am-modal__frame iframe {
    display: block;
    width: 100%;
    height: 450px;
    border: 0;
    background: transparent;
  }

  /* Loading overlay — hides Apple's blank placeholder until ready. */
  .am-modal__loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: #f2f2f2;
    border-radius: 16px;
    transition: opacity 0.4s ease;
  }
  :global([data-theme="dark"]) .am-modal__loading {
    background: #2a2a2c;
  }
  .am-modal__loading.is-done {
    opacity: 0;
    pointer-events: none;
  }
  .am-progress {
    width: min(62%, 260px);
    height: 4px;
    border-radius: 999px;
    background: rgba(128, 128, 128, 0.25);
    overflow: hidden;
  }
  .am-progress__bar {
    display: block;
    width: 0;
    height: 100%;
    border-radius: 999px;
    background: #fa2d48; /* Apple Music red */
    /* Decelerating crawl toward 90% over ~6s (overridden on reveal). */
    transition: width 6s cubic-bezier(0.12, 0.85, 0.2, 1);
  }

  .am-modal__close {
    position: absolute;
    top: -14px;
    right: -14px;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    color: #111;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
    transition: transform 0.15s ease;
  }
  .am-modal__close:hover {
    transform: scale(1.08);
  }

  @media (max-width: 600px) {
    .am-modal__close {
      top: -10px;
      right: 4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .am-modal,
    .am-modal__card {
      transition: none;
    }
  }
</style>
