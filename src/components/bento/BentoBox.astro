---
interface Props {
  url?: string;
  bg_image?: string;
  lg: [number, number, number, number];
  sm: [number, number, number, number];
  align?: "start" | "center";
  class?: string[];
}

const {
  url,
  bg_image,
  lg,
  sm,
  align = "left",
  class: className = [],
} = Astro.props;

const classes = [...className, "bento-box"];
if (url) classes.push("bento-box--clickable");
if (bg_image) classes.push("bento-box--with-image");
if (align === "center") classes.push("bento-box--center");

const style = [
  `--lg:${lg.join(" / ")}`,
  `--sm:${sm.join(" / ")}`,
  bg_image ? `--bg-image:${bg_image}` : "",
]
  .filter(Boolean)
  .join(";");
---

{
  url ? (
    <a href={url} class:list={classes} style={style}>
      <slot />
    </a>
  ) : (
    <div class:list={classes} style={style}>
      <slot />
    </div>
  )
}

<style>
  .bento-box {
    grid-area: var(--sm);
    border-radius: 1rem;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(162, 89, 236, 0.12);
    backdrop-filter: blur(10px);
    box-shadow: 0 4px 16px -4px rgba(0, 0, 0, 0.06);
    transition:
      transform 0.2s,
      box-shadow 0.2s,
      border-color 0.2s;
    text-decoration: none;
    color: inherit;
  }

  :global(.dark) .bento-box {
    background: rgba(20, 15, 30, 0.5);
    border-color: rgba(162, 89, 236, 0.18);
    box-shadow:
      0 4px 24px -2px rgba(0, 0, 0, 0.35),
      0 0 0 1px rgba(255, 255, 255, 0.04) inset;
  }

  @media (min-width: 1024px) {
    .bento-box {
      grid-area: var(--lg);
    }
  }

  .bento-box--center {
    align-items: center;
  }

  .bento-box--with-image {
    background-image: var(--bg-image);
    background-size: cover;
    background-position: center;
    background-blend-mode: overlay;
    background-color: rgba(80, 50, 110, 0.65);
    color: white;
  }

  .bento-box--clickable {
    cursor: pointer;
  }

  .bento-box--clickable:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 28px -6px rgba(162, 89, 236, 0.2);
    border-color: rgba(162, 89, 236, 0.35);
  }

  :global(.dark) .bento-box--clickable:hover {
    box-shadow: 0 10px 28px -6px rgba(162, 89, 236, 0.3);
    border-color: rgba(162, 89, 236, 0.4);
  }

  .bento-box--clickable:active {
    transform: scale(0.98);
    box-shadow: none;
  }
</style>
