---
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import '@styles/markdown.css';
import { useTranslations } from '@utils/ui';
import SupabaseComments from '@components/SupabaseComments.astro';
import TableOfContents from '@components/TableOfContents.astro';
import TravelMap from '@components/TravelMap.astro';
import {
  filterPostsBySection,
  getOgImagePath,
  getSectionBasePath,
  getSectionPostUrl,
  getTranslationKey,
  localizePosts,
  resolvePostForLocale,
  sortByPubDateDesc,
} from '@utils/posts';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => {
    // 只包含已发布的文章
    return data.published !== false;
  });

  return Array.from(new Set(filterPostsBySection(allPosts, 'blog').map(getTranslationKey))).map((key) => ({
    params: { slug: key },
    props: { translationKey: key },
  }));
}

const { translationKey } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const locale = Astro.currentLocale;

// 查找当前语言的文章，如果没有则回退到其他语言
const allPosts = await getCollection('blog', ({ data }) => {
  // 只包含已发布的文章
  return data.published !== false;
});
const blogPosts = filterPostsBySection(allPosts, 'blog');
const { post, isFallback } = resolvePostForLocale(blogPosts, translationKey, locale ?? 'zh');

if (!post) {
  throw new Error(`Post not found: ${translationKey}`);
}


// 获取上一篇和下一篇文章
const sortedPosts = sortByPubDateDesc(localizePosts(blogPosts, locale ?? 'zh'));
const currentIndex = sortedPosts.findIndex((item) => item.key === translationKey);
const prevPost = currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1].post : null;
const nextPost = currentIndex > 0 ? sortedPosts[currentIndex - 1].post : null;

function getPostUrl(p: typeof post | null) {
  if (!p) return '#';
  return getSectionPostUrl(getTranslationKey(p), 'blog', locale);
}

const categoryNames: Record<string, { zh: string; en: string }> = {
  ctf: { zh: 'CTF', en: 'CTF' },
  notes: { zh: '笔记', en: 'Notes' },
  record: { zh: '记录', en: 'Records' },
  thoughts: { zh: '随笔', en: 'Thoughts' },
  weekly: { zh: '周记', en: 'Weekly' },
  tech: { zh: '技术', en: 'Tech' },
  life: { zh: '生活', en: 'Life' },
  uncategorized: { zh: '未分类', en: 'Uncategorized' },
};

function getCategoryDisplayName(category: string) {
  return categoryNames[category]?.[locale === 'en' ? 'en' : 'zh'] || category;
}

import { ICONS } from '@utils/icons';

const { Content, headings } = await post.render();
const category = post.data.category || 'uncategorized';
const categoryDisplay = getCategoryDisplayName(category);
const categoryUrl = locale === 'en' ? `/en/category/${category}` : `/category/${category}`;
const blogIndexUrl = getSectionBasePath('blog', locale);
const backToBlogLabel = locale === 'en' ? 'Back to Blog' : '返回博客';
const languageDisplay = post.data.lang === 'zh' ? 'zh-CN' : 'en-US';
const postDateLabel = post.data.pubDate.toLocaleDateString(locale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const ogImageUrl = new URL(getOgImagePath(translationKey, locale), Astro.site).toString();

// 检测内容中是否包含数学公式或 Mermaid 图表
const rawContent = post.body;
const hasLatex = /\$.*?\$|\$\$[\s\S]*?\$\$/.test(rawContent);
const hasMermaid = /```mermaid/.test(rawContent);
const hasTravelMap = /::travel-map\b/.test(rawContent);
---
<Layout
  title={post.data.title}
  desc={post.data.description}
  translationKey={translationKey}
  ogImage={ogImageUrl}
  ogType="article"
>
  <!-- 按需加载 KaTeX CSS -->
  {hasLatex && (
    <link
      slot="head"
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
      integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV"
      crossorigin="anonymous"
    />
  )}
  
  <main class="post-container">
    <div class="post-topbar">
      <a href={blogIndexUrl} class="post-back-link" aria-label={backToBlogLabel}>
        <span class="post-back-icon" set:html={ICONS.arrowLeft} />
        <span>{backToBlogLabel}</span>
      </a>
    </div>

    <h1>{post.data.title}</h1>
    
    {isFallback && (
      <div class="fallback-tip">
        {t('post_not_translated')}
      </div>
    )}
    
    <div class="post-meta">
      <time datetime={post.data.pubDate.toISOString()} class="post-meta-item post-meta-date">
        <span class="post-meta-icon" set:html={ICONS.calendar} />
        <span class="post-meta-text">{postDateLabel}</span>
      </time>
      <a href={categoryUrl} class="post-meta-item post-meta-link">
        <span class="post-meta-icon" set:html={ICONS.category} />
        <span class="post-meta-text">{categoryDisplay}</span>
      </a>
      <span class="post-meta-item">
        <span class="post-meta-icon" set:html={ICONS.language} />
        <span class="post-meta-text">{languageDisplay}</span>
      </span>
    </div>
    
    <TableOfContents headings={headings} />
    
    <div class="markdown-content">
      <Content />
    </div>

    {hasTravelMap && <TravelMap />}

    <hr class="comment-divider" />

    <div class="post-navigation">
      {prevPost ? (
        <a href={getPostUrl(prevPost)} class="nav-item prev">
          <span class="nav-label">
            <span class="icon" set:html={ICONS.arrowLeft} />
            {t('post_prev')}
          </span>
          <span class="nav-title">{prevPost.data.title}</span>
        </a>
      ) : (
        <div class="nav-item empty"></div>
      )}

      {nextPost ? (
        <a href={getPostUrl(nextPost)} class="nav-item next">
          <span class="nav-label">
            {t('post_next')}
            <span class="icon" set:html={ICONS.arrowRight} />
          </span>
          <span class="nav-title">{nextPost.data.title}</span>
        </a>
      ) : (
        <div class="nav-item empty"></div>
      )}
    </div>
    
    <hr class="comment-divider" />
    
    <SupabaseComments 
      translationKey={translationKey} 
      postTitle={post.data.title}
      postUrl={`${Astro.site?.origin || ''}${Astro.url.pathname}`}
    />
  </main>
</Layout>

<script>
  // 使用立即执行的方式初始化博客增强功能
  import { initializeAll } from '@utils/blog-enhancements';
  import { applyAutoSpaceToTextNodes } from '@utils/auto-space';

  const runPageEnhancements = () => {
    initializeAll();
    const markdown = document.querySelector('.post-container .markdown-content');
    if (markdown) {
      applyAutoSpaceToTextNodes(markdown);
    }

    const backLink = document.querySelector<HTMLAnchorElement>('.post-back-link');
    if (backLink && backLink.dataset.smartBackBound !== 'true') {
      backLink.dataset.smartBackBound = 'true';
      backLink.addEventListener('click', (event) => {
        const hasHistory = window.history.length > 1;
        if (!hasHistory || !document.referrer) return;

        let sameOriginReferrer = false;
        try {
          sameOriginReferrer =
            new URL(document.referrer).origin === window.location.origin;
        } catch {
          sameOriginReferrer = false;
        }

        if (sameOriginReferrer) {
          event.preventDefault();
          window.history.back();
        }
      });
    }
  };
  
  // 立即执行初始化
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      runPageEnhancements();
    });
  } else {
    // DOM 已经加载完成，立即执行
    runPageEnhancements();
  }
  
  // 支持 Astro View Transitions
  document.addEventListener('astro:page-load', () => {
    runPageEnhancements();
  });
</script>

<script define:vars={{ hasMermaid, hasLatex }}>
  // 记录当前页面需要的资源，用于预加载优化
  if (typeof window !== 'undefined') {
    window.__pageFeatures = { hasMermaid, hasLatex };
  }
</script>

<style>
  .post-container {
    max-width: 800px;
    margin: 5rem auto 2rem;
    padding: 20px;
    width: 100%;
    /* 不设置 overflow，让子元素自己处理 */
    /* 使用 box-sizing 确保 padding 不会增加总宽度 */
    box-sizing: border-box;
    touch-action: pan-y;
  }
  
  /* markdown 内容容器 */
  .markdown-content {
    /* 限制内容最大宽度，防止撑开 */
    max-width: 100%;
    overflow-wrap: break-word;
    word-wrap: break-word;
    text-autospace: ideograph-alpha ideograph-numeric;
  }

  .post-container h1 {
    font-family: var(--font-serif);
    font-size: 3rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    /* 长标题自动换行 */
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  .post-topbar {
    margin-bottom: 0.4rem;
    touch-action: pan-y;
  }

  .post-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.5rem 0.25rem 0.35rem;
    border-radius: 6px;
    text-decoration: none;
    color: var(--grey);
    font-family: var(--font-sans);
    font-size: 0.88rem;
    line-height: 1;
    touch-action: pan-y;
    transition: color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  .post-back-link:hover {
    color: var(--text);
    background: rgba(162, 89, 236, 0.08);
    transform: translateX(-1px);
  }

  .post-back-icon {
    width: 0.95rem;
    height: 0.95rem;
    display: inline-flex;
    color: currentColor;
  }

  .post-back-icon :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-bottom: 2rem;
    touch-action: pan-y;
  }

  .post-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid rgba(162, 89, 236, 0.2);
    border-radius: 5px;
    color: var(--purple);
    background: rgba(162, 89, 236, 0.1);
    font-family: var(--font-serif);
    font-size: 0.82rem;
    line-height: 1.2;
    white-space: nowrap;
    touch-action: pan-y;
  }

  .post-meta-date .post-meta-text {
    font-family: var(--font-serif);
    letter-spacing: 0.01em;
  }

  .post-meta-link {
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .post-meta-link:hover {
    background: rgba(162, 89, 236, 0.2);
    transform: translateY(-1px);
  }

  .post-meta-icon {
    width: 0.95rem;
    height: 0.95rem;
    display: inline-flex;
    color: currentColor;
    opacity: 0.9;
  }

  .post-meta-icon :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  :global(html.dark) .post-meta-item {
    color: #c6b7dc;
    background: rgba(198, 183, 220, 0.12);
    border-color: rgba(198, 183, 220, 0.26);
  }

  :global(html.dark) .post-meta-link:hover {
    background: rgba(198, 183, 220, 0.2);
    border-color: rgba(198, 183, 220, 0.36);
  }

  :global(html.dark) .post-back-link:hover {
    color: #e4dcf2;
    background: rgba(198, 183, 220, 0.16);
  }

  .fallback-tip {
    font-family: var(--font-sans);
    color: var(--grey);
    background: rgba(162, 89, 236, 0.1);
    border: 1px solid rgba(162, 89, 236, 0.25);
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    display: inline-block;
    margin-bottom: 1rem;
  }

  /* Post Navigation */
  .post-navigation {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    /* margin-top 和 padding-top 移除，由 hr.comment-divider 控制间距 */
  }

  .nav-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-decoration: none;
    padding: 1rem;
    border-radius: 12px;
    border: 1px solid transparent;
    transition: all 0.2s ease;
  }

  .nav-item:not(.empty):hover {
    background: rgba(136, 136, 136, 0.1);
    transform: translateY(-2px);
  }

  .nav-item.next {
    text-align: right;
    align-items: flex-end;
  }

  .nav-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--grey);
  }

  .nav-title {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--text);
    font-weight: 500;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .nav-item .icon {
    width: 1.2em;
    height: 1.2em;
    transition: transform 0.2s ease;
  }

  .nav-item.prev:hover .icon {
    transform: translateX(-4px);
  }

  .nav-item.next:hover .icon {
    transform: translateX(4px);
  }

  /* 评论区分隔线 */
  .comment-divider {
    margin: 3rem 0 2.5rem;
    border: none;
    border-top: 1px solid var(--grey);
    opacity: 0.3;
  }

  /* 移动端优化 */
  @media (max-width: 768px) {
    .post-container {
      padding: 15px;
      margin: 4rem auto 1.5rem;
    }

    .post-container h1 {
      font-size: 2rem;
    }

    .post-back-link {
      font-size: 0.82rem;
      padding: 0.22rem 0.42rem 0.22rem 0.3rem;
    }

    .post-navigation {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .post-meta {
      gap: 0.5rem;
      margin-bottom: 1.6rem;
    }

    .post-meta-item {
      padding: 0.24rem 0.58rem;
      font-size: 0.78rem;
    }

    .nav-item.next {
      text-align: left;
      align-items: flex-start;
    }

    .nav-item.next .nav-label {
      flex-direction: row-reverse;
      justify-content: flex-end;
    }
  }
</style>
